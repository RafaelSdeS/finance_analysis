# BolsAI API Configuration
BOLSAI_API_KEY=your_api_key_here

# Data Collection Settings (optional)
LOG_LEVEL=INFO
CHECKPOINT_DIR=data/checkpoints

# SEC EDGAR fair-access: identify the requester (see sec/http.py)
SEC_USER_AGENT=your-app-name your-email@example.com

# Alpha Vantage (optional, free tier 25 req/day): US price cross-vendor validation
# (tests/data_collection/validate_us_vs_vendor.py). Unset = that section SKIPs.
ALPHAVANTAGE_API_KEY=your_api_key_here
